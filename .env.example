# Public URL of the deployed site (used for metadata, sitemap and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://forged-by-samarth.vercel.app

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Samarth Patel <hello@samarthpatel.dev>"
RESEND_FROM_EMAIL=
# Where new project enquiries and chat notifications are delivered
CONTACT_TO_EMAIL=

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
