# Public URL of the deployed site (used for metadata, sitemap and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://forged-by-samarth.vercel.app

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. "Samarth Patel <hello@samarthpatel.dev>"
RESEND_FROM_EMAIL=
# Where new project enquiries and chat notifications are delivered
CONTACT_TO_EMAIL=

# MongoDB Atlas connection string — Database → Connect → Drivers
MONGODB_URI=
# Database name (defaults to "forge")
MONGODB_DB=

# Better Auth — generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The site's own URL; use http://localhost:3000 locally (defaults to NEXT_PUBLIC_SITE_URL)
BETTER_AUTH_URL=
# Comma-separated emails that get the inbox (defaults to the email in lib/site.ts)
ADMIN_EMAILS=

# OAuth apps — leave blank to hide a provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Search Console verification token (the content="…" value of the HTML tag)
GOOGLE_SITE_VERIFICATION=
